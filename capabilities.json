{
    "privileges": [
        {
            "name": "ExportContent",
            "essential": false
        }
    ],
    "dataRoles": [
        {
            "displayName": "Person ID *",
            "description": "Required. The unique key for each row \u2014 employee number, email, account code, part number. One card per unique value.",
            "name": "personId",
            "displayNameKey": "Role_PersonId",
            "kind": "Grouping"
        },
        {
            "displayName": "Reports to *",
            "description": "Required. The parent's key, in the same format as Person ID. Blank, missing, self-referencing or unknown parents all make the row a root \u2014 no magic values needed.",
            "name": "parentId",
            "displayNameKey": "Role_ParentId",
            "kind": "Grouping"
        },
        {
            "displayName": "Dotted-line manager",
            "description": "Optional. A second manager, drawn as a dashed connector. Never changes where a card sits \u2014 the layout always follows 'Reports to'.",
            "name": "secondaryParentId",
            "displayNameKey": "Role_SecondaryParentId",
            "kind": "Grouping"
        },
        {
            "displayName": "Name",
            "description": "Optional. Display name on the card. Falls back to Person ID when unbound.",
            "name": "personName",
            "displayNameKey": "Role_Name",
            "kind": "Grouping"
        },
        {
            "displayName": "Title",
            "description": "Optional. Job title or role \u2014 the card's second line.",
            "name": "personTitle",
            "displayNameKey": "Role_Title",
            "kind": "Grouping"
        },
        {
            "displayName": "Photo",
            "description": "Optional. A base64 data URI per row. Images are never fetched from a URL \u2014 the visual makes no network calls.",
            "name": "photo",
            "displayNameKey": "Role_Photo",
            "kind": "Grouping"
        },
        {
            "displayName": "Group",
            "description": "Optional. Department, location or band. Drives card colour and the legend.",
            "name": "group",
            "displayNameKey": "Role_Group",
            "kind": "Grouping"
        },
        {
            "displayName": "Measure",
            "description": "Optional. Any number \u2014 headcount, cost, tenure, score. Shown as a badge on the card.",
            "name": "measure",
            "displayNameKey": "Role_Measure",
            "kind": "Measure"
        },
        {
            "displayName": "Tooltips",
            "description": "Optional. Extra fields to show on hover.",
            "name": "tooltips",
            "displayNameKey": "Role_Tooltips",
            "kind": "GroupingOrMeasure"
        },
        {
            "displayName": "Period",
            "description": "Optional. A snapshot label per row \u2014 a date or a period like 2026-Q1. Enables comparing the org across two periods to show joiners, leavers and movers.",
            "name": "period",
            "displayNameKey": "Role_Period",
            "kind": "Grouping"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "personId": {
                        "max": 1
                    },
                    "parentId": {
                        "max": 1
                    },
                    "personName": {
                        "max": 1
                    },
                    "personTitle": {
                        "max": 1
                    },
                    "photo": {
                        "max": 1
                    },
                    "group": {
                        "max": 1
                    },
                    "measure": {
                        "max": 1
                    },
                    "secondaryParentId": {
                        "max": 1
                    },
                    "period": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "personId"
                            }
                        },
                        {
                            "for": {
                                "in": "parentId"
                            }
                        },
                        {
                            "for": {
                                "in": "personName"
                            }
                        },
                        {
                            "for": {
                                "in": "personTitle"
                            }
                        },
                        {
                            "for": {
                                "in": "photo"
                            }
                        },
                        {
                            "for": {
                                "in": "group"
                            }
                        },
                        {
                            "for": {
                                "in": "secondaryParentId"
                            }
                        },
                        {
                            "for": {
                                "in": "period"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": {
                                "in": "measure"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "layout": {
            "displayName": "Layout",
            "properties": {
                "orientation": {
                    "displayName": "Orientation",
                    "description": "Top-down for shallow, wide charts; left-to-right for deep ones.",
                    "type": {
                        "enumeration": [
                            {
                                "value": "topDown",
                                "displayName": "Top-down"
                            },
                            {
                                "value": "leftRight",
                                "displayName": "Left-to-right"
                            }
                        ]
                    },
                    "displayNameKey": "Prop_layout_orientation"
                },
                "levelGap": {
                    "displayName": "Level spacing",
                    "type": {
                        "numeric": true
                    },
                    "displayNameKey": "Prop_layout_levelGap"
                },
                "siblingGap": {
                    "displayName": "Sibling spacing",
                    "type": {
                        "numeric": true
                    },
                    "displayNameKey": "Prop_layout_siblingGap"
                },
                "leafStack": {
                    "displayName": "Leaf reports",
                    "description": "Put a manager's direct reports in columns so wide teams stay readable. Auto stacks a team only when that draws the chart larger.",
                    "type": {
                        "enumeration": [
                            {
                                "value": "auto",
                                "displayName": "Auto"
                            },
                            {
                                "value": "row",
                                "displayName": "Row"
                            },
                            {
                                "value": "stacked",
                                "displayName": "Stacked"
                            }
                        ]
                    },
                    "displayNameKey": "Prop_layout_leafStack"
                },
                "fillViewport": {
                    "displayName": "Fill the viewport",
                    "description": "Stretch the spacing between levels so the chart uses the whole visual rather than sitting as a thin band in the middle. While this is on, level spacing is a minimum.",
                    "type": {
                        "bool": true
                    },
                    "displayNameKey": "Prop_layout_fillViewport"
                },
                "collapseToFit": {
                    "displayName": "Collapse deep levels to fit",
                    "description": "Open a large hierarchy with its deep levels collapsed instead of scaled down too far to read. Turning this off does not expand branches that are already collapsed.",
                    "type": {
                        "bool": true
                    },
                    "displayNameKey": "Prop_layout_collapseToFit"
                },
                "collapseToFitDone": {
                    "type": {
                        "bool": true
                    }
                },
                "collapsed": {
                    "type": {
                        "text": true
                    },
                    "filterState": true
                }
            },
            "displayNameKey": "Obj_Layout"
        },
        "nodes": {
            "displayName": "Nodes",
            "properties": {
                "sizeMode": {
                    "displayName": "Card sizing",
                    "description": "By level grows cards towards the root \u2014 a leaf stays the size set here, its manager is larger, the root larger still \u2014 by as much as the space allows without shrinking the leaves. Auto keeps one size for every card but draws above 1:1 when there is room. Fixed keeps exactly the width and height set here.",
                    "type": {
                        "enumeration": [
                            {
                                "value": "level",
                                "displayName": "By level \u2014 bigger nearer the top"
                            },
                            {
                                "value": "auto",
                                "displayName": "Auto \u2014 grow to fit the visual"
                            },
                            {
                                "value": "fixed",
                                "displayName": "Fixed"
                            }
                        ]
                    },
                    "displayNameKey": "Prop_nodes_sizeMode"
                },
                "cardWidth": {
                    "displayName": "Card width",
                    "type": {
                        "numeric": true
                    },
                    "displayNameKey": "Prop_nodes_cardWidth"
                },
                "cardHeight": {
                    "displayName": "Card height",
                    "type": {
                        "numeric": true
                    },
                    "displayNameKey": "Prop_nodes_cardHeight"
                },
                "cornerRadius": {
                    "displayName": "Corner radius",
                    "type": {
                        "numeric": true
                    },
                    "displayNameKey": "Prop_nodes_cornerRadius"
                },
                "showPhoto": {
                    "displayName": "Show photo",
                    "type": {
                        "bool": true
                    },
                    "displayNameKey": "Prop_nodes_showPhoto"
                },
                "photoShape": {
                    "displayName": "Photo shape",
                    "description": "Circle is the default. The image is clipped to the shape \u2014 before this it was drawn as a square behind a round outline.",
                    "type": {
                        "enumeration": [
                            {
                                "value": "circle",
                                "displayName": "Circle"
                            },
                            {
                                "value": "rounded",
                                "displayName": "Rounded square"
                            },
                            {
                                "value": "square",
                                "displayName": "Square"
                            }
                        ]
                    },
                    "displayNameKey": "Prop_nodes_photoShape"
                },
                "photoSize": {
                    "displayName": "Photo size",
                    "description": "Diameter as a percentage of the card height. The default reproduces the size the visual drew before this control existed.",
                    "type": {
                        "numeric": true
                    },
                    "displayNameKey": "Prop_nodes_photoSize"
                },
                "photoRing": {
                    "displayName": "Photo outline",
                    "type": {
                        "bool": true
                    },
                    "displayNameKey": "Prop_nodes_photoRing"
                },
                "photoRingColor": {
                    "displayName": "Outline colour",
                    "description": "Leave blank to follow the card's own accent colour.",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    },
                    "displayNameKey": "Prop_nodes_photoRingColor"
                },
                "photoRingWidth": {
                    "displayName": "Outline width",
                    "type": {
                        "numeric": true
                    },
                    "displayNameKey": "Prop_nodes_photoRingWidth"
                },
                "photoFallback": {
                    "displayName": "When there is no photo",
                    "description": "What to draw for a row whose Photo is empty. Keeping the space reserved stops a mixed dataset drawing ragged cards.",
                    "type": {
                        "enumeration": [
                            {
                                "value": "initials",
                                "displayName": "Initials"
                            },
                            {
                                "value": "icon",
                                "displayName": "Person icon"
                            },
                            {
                                "value": "blank",
                                "displayName": "Empty circle"
                            },
                            {
                                "value": "none",
                                "displayName": "Nothing \u2014 close up the space"
                            }
                        ]
                    },
                    "displayNameKey": "Prop_nodes_photoFallback"
                },
                "showMeasure": {
                    "displayName": "Show measure badge",
                    "type": {
                        "bool": true
                    },
                    "displayNameKey": "Prop_nodes_showMeasure"
                }
            },
            "displayNameKey": "Obj_Nodes"
        },
